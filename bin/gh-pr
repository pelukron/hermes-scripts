#!/usr/bin/env bash
# Create PR from current branch, linking to the issue.
#
# DEPRECADO: prefiere bin/bump-and-pr.sh "<tipo>: <descripción>", que hace el
# flujo completo. Este script se mantiene para abrir el PR de una rama existente.

set -euo pipefail

OWNER="pelukron"
REPO="hermes-scripts"

if [ $# -lt 2 ]; then
  echo "Usage: $(basename "$0") <issue-number> <branch>"
  exit 1
fi

ISSUE_NUM="$1"
BRANCH="$2"

if ! git rev-parse --verify "$BRANCH" &> /dev/null; then
  echo "Error: branch '$BRANCH' not found." && exit 1
fi

git checkout "$BRANCH"

# Ensure branch is pushed
if ! git rev-parse --abbrev-ref --symbolic-full-name "@{u}" &> /dev/null 2>&1; then
  git push -u origin "$BRANCH"
fi

# Titulo convencional sin prefijo emoji (lo exige el job commitlint de CI).
TITLE=$(gh issue view "$ISSUE_NUM" --repo "$OWNER/$REPO" --json title --jq '.title')
LABELS=$(gh issue view "$ISSUE_NUM" --repo "$OWNER/$REPO" --json labels --jq '.labels[].name' | paste -sd "," -)

BODY="Closes #${ISSUE_NUM}

This PR addresses #${ISSUE_NUM}.

## Checklist
- [ ] Corrí \`bash bin/gate.sh\` en local
- [ ] CHANGELOG.md intacto (lo genera PSR al mergear)"

echo "Creating PR for branch '$BRANCH' linked to issue #$ISSUE_NUM..."
gh pr create \
  --repo "$OWNER/$REPO" \
  --title "${TITLE} (#${ISSUE_NUM})" \
  --body "$BODY" \
  --label "$LABELS" \
  --base main \
  --head "$BRANCH"

echo "✅ Done."
