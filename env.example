# Variables de entorno que usan los scripts y el flujo de PR de este repo.
# Copia las que necesites a ~/.hermes/.env (Hermes) o expórtalas en tu shell.
# Nunca versiones valores reales: este archivo solo documenta nombres.

# GitHub — bin/bump-and-pr.sh, bin/post-merge.sh y el CLI gh
GITHUB_TOKEN=

# Telegram — solo lo usa el job "notify" del CI (.github/workflows/ci.yml).
# Los scripts de cron NO necesitan token: Hermes entrega su stdout.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcionales
# UV=/ruta/a/uv                    # si uv no está en PATH
# HERMES_SCRIPTS_DIR=/ruta/al/repo  # si el repo no vive en $HOME/hermes-scripts
# HERMES_HOME=/ruta/.hermes         # si tu Hermes no usa ~/.hermes
# HERMES_MODEL=<modelo>             # solo informativo: lo reporta reporte-uso-hermes.py
