{
  "_doc": "Clones de runtime que deben seguir main. Solo los toca el job runtime-sync (ff-only, nunca force).",
  "clones": [
    {
      "name": "empleo-prod",
      "path": "~/src/hermes-empleo-prod",
      "branch": "main",
      "smoke": "$HOME/empleo/.venv/bin/python bin/job-scout.py --version",
      "links": [
        {
          "path": "~/.hermes/skills/custom/job-scout",
          "expect": "skills/job-scout"
        }
      ]
    },
    {
      "name": "hermes-scripts",
      "path": "~/hermes-scripts",
      "branch": "main",
      "smoke": "env -u VIRTUAL_ENV uv run python -m scripts.sync_runtime --help",
      "links": [
        {
          "path": "~/.hermes/skills/github/github-pelukron-flow",
          "expect": "skills/github-pelukron-flow"
        },
        {
